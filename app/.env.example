# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by the PayPal webhook to write
# across tenants (bypasses RLS). Get it from Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PayPal (developer.paypal.com → your app) ---
PAYPAL_ENV=sandbox                       # sandbox | live
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id        # from the webhook you created in PayPal
PAYPAL_PLAN_ID=P-XXXXXXXXXXXX            # the £99/month plan, reused per client

# --- Cal.com (calendar sync webhook, W4) ---
# The shared secret set on each tenant's Cal.com webhook. The webhook URL carries
# the tenant: https://<domain>/api/calcom/webhook?account_id=<uuid>
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret
