# ============================================================================
# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).
# ============================================================================

# --- TikTok for Developers (https://developers.tiktok.com) ---------------
# Create an app, add the "Login Kit" + "Content Posting API" products, and
# request the scopes: user.info.basic, video.upload, video.publish
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
# Redirect URI must EXACTLY match what you registered in the app settings.
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# Tokens are written here by scripts/auth_tiktok.py after the OAuth flow.
# (You normally do not paste these by hand.)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Higgsfield (https://higgsfield.ai) ----------------------------------
# Only needed if you use the REST/SDK path. If you use the Higgsfield MCP
# server inside Claude Code, auth is handled via OAuth in the browser and
# you do NOT need these.
HF_API_KEY=
HF_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
