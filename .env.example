# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Anthropic (Claude) ---------------------------------------------------
# Get from https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Shopify Admin API ----------------------------------------------------
# Create a *custom app* in your Shopify admin:
#   Settings → Apps and sales channels → Develop apps → Create an app
# Then configure Admin API scopes (read_products, write_products,
# read_orders, etc.) and install it to get the access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
# API version is date-based; bump quarterly. See docs.shopify.com/api/release-notes
SHOPIFY_API_VERSION=2025-01

# Shared secret used to verify incoming webhooks (Settings → Notifications →
# Webhooks, or set when registering webhooks via the API).
SHOPIFY_WEBHOOK_SECRET=...

# --- Higgsfield -----------------------------------------------------------
# Higgsfield is primarily used via its app / MCP integration for creative
# generation. If/when you use a direct API, store the key here.
HIGGSFIELD_API_KEY=

# --- Ad platforms (creative is generated by Higgsfield; delivery here) ----
# These are optional and only needed if you automate campaign creation.
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Server ---------------------------------------------------------------
PORT=3000
