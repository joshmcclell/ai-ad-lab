# Copy this file to ".env" and fill in your IC Markets MT5 credentials.
# NEVER commit your real .env — it is git-ignored.

# --- IC Markets MT5 login (from the MT5 terminal: File > Login to Trade Account)
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password

# Server string EXACTLY as shown in your terminal. Common values:
#   ICMarketsSC-Demo        (demo)
#   ICMarketsSC-Live01      (live)   ICMarketsSC-Live02 ...
#   ICMarkets-Demo / -Live  (older naming)
MT5_SERVER=ICMarketsSC-Demo

# Optional: full path to terminal64.exe (leave blank to auto-detect a running
# terminal). Example: C:\Program Files\MetaTrader 5 IC Markets\terminal64.exe
MT5_TERMINAL_PATH=

# Gold symbol on your account. Usually "XAUUSD"; some account types use a
# suffix such as "XAUUSD.a". Run `python bot.py --list-symbols` if unsure.
MT5_SYMBOL=XAUUSD

# Safety: keep this "true" until you have demo-tested. "false" allows live.
DEMO_MODE=true

# Trade around the clock (true) instead of only 08:00-16:00 London (false).
# Heads-up: spreads widen outside London/NY hours, which hurts scalping.
TRADE_24H=false

# Where trades are logged.
TRADE_LOG_CSV=logs/trades.csv
LOG_LEVEL=INFO

# --- Telegram alerts (optional) — see ALERTS.md ---------------------------
# Get notified when the bot opens/closes a trade or errors. Leave ALERTS=false
# to disable. Steps: message @BotFather to make a bot (get the token), message
# your new bot once, then run `wine python bot.py --telegram-setup` for the ID.
ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
