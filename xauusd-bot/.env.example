# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env — it is git-ignored on purpose.
# ---------------------------------------------------------------------------

# --- IC Markets MT5 login (from the MT5 terminal: File > Login to Trade Account)
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
# IC Markets server name. Demo examples: "ICMarketsSC-Demo", "ICMarkets-Demo02".
# Live examples: "ICMarketsSC-Live01", "ICMarketsSC-Live02".
# The exact string is shown in MT5 under File > Login to Trade Account > Server.
MT5_SERVER=ICMarketsSC-Demo

# Optional: full path to terminal64.exe. Leave blank to auto-detect a running MT5.
# Example (Windows): C:\Program Files\MetaTrader 5 IC Markets\terminal64.exe
MT5_TERMINAL_PATH=

# --- Trading mode --------------------------------------------------------
# "demo" (default, safe) or "live". Live ALSO requires LIVE_CONFIRM=YES_I_UNDERSTAND.
TRADE_MODE=demo
LIVE_CONFIRM=

# --- Instrument & timeframe ---------------------------------------------
# IC Markets usually lists gold as plain "XAUUSD". Some account types add a
# suffix (e.g. "XAUUSD.a", "XAUUSD.i"). If the bot can't find the symbol it
# will print the closest matches — copy the exact name here.
SYMBOL=XAUUSD
TIMEFRAME=H1

# Trading hours filter (server time, 24h). Trades only open inside this window.
# Set START=00:00 and END=23:59 to disable the filter.
TRADE_HOUR_START=00:00
TRADE_HOUR_END=23:59

# --- Risk & strategy parameters -----------------------------------------
RISK_PER_TRADE=0.01          # fraction of balance risked per trade. 0.01 = 1% (safe).
                             # Can be set up to 1.0 (100%). Anything >0.10 is flagged as
                             # HIGH RISK at startup — a few losers can wipe a small account.
RISK_REWARD=2.0              # take-profit = RR * stop distance
DAILY_LOSS_LIMIT=0.03        # pause for the day after losing this fraction of balance.
                             # Set to 0 to DISABLE the daily loss pause entirely.
SL_METHOD=atr                # "atr" or "swing"
ATR_MULTIPLIER=1.5
SWING_LOOKBACK=10            # bars used to find recent swing high/low
SMA_FAST=50
SMA_SLOW=200
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
ATR_PERIOD=14
MAGIC_NUMBER=990011          # identifies THIS bot's orders; leave as-is unless you run several

# --- Loop / behaviour ----------------------------------------------------
POLL_SECONDS=30              # how often the main loop wakes up
MAX_SPREAD_POINTS=0          # 0 = ignore; otherwise skip entries when spread is wider

# --- Optional Telegram alerts -------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
