# Copy this file to ".env" and fill in your IC Markets MT5 + Telegram details.
# NEVER commit your real .env - it is git-ignored.

# --- IC Markets MT5 login (from the MT5 terminal: File > Login to Trade Account)
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password

# Server string EXACTLY as shown in your terminal. Common values:
#   ICMarketsSC-Demo        (demo)
#   ICMarketsSC-Live01      (live)   ICMarketsSC-Live02 ...
#   ICMarkets-Demo / -Live  (older naming)
MT5_SERVER=ICMarketsSC-Demo

# Optional: full path to terminal64.exe (leave blank to auto-detect a running
# terminal). Example: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Gold symbol on your account. Usually "XAUUSD"; some account types use a
# suffix such as "XAUUSD.a". Run `wine python bot.py --list-symbols` if unsure.
MT5_SYMBOL=XAUUSD

# Safety: "true" refuses to trade a LIVE account. Keep true until demo-tested.
DEMO_MODE=true

# Trade only the London session 08:00-16:00 (false) or around the clock (true).
# This strategy is built for the London session, so keep this false.
TRADE_24H=false

# This strategy trades EXACTLY 0.05 lots on every order. Leave as 0.05.
FIXED_LOT=0.05

# Max broker spread (in POINTS) to allow a trade. The strategy spec says 2.0,
# but IC Markets raw XAUUSD spread is typically ~15-30 points, so 2.0 will
# likely block every trade. If nothing fires, raise this (e.g. 25).
MAX_SPREAD_POINTS=2.0

# Where trades are logged.
TRADE_LOG_CSV=logs/trades.csv
LOG_LEVEL=INFO

# --- Telegram alerts (REQUIRED by this build) - see ALERTS.md -------------
# 1. In Telegram message @BotFather -> /newbot -> copy the TOKEN below.
# 2. Message your new bot once ("hi").
# 3. Run: wine python bot.py --telegram-setup  -> copy your CHAT ID below.
ALERTS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
